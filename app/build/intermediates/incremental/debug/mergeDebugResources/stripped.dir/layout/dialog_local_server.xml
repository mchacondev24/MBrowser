<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_glass_card">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_dns"
            android:tint="@color/game_emerald" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ApacheMysqlAndroid Server"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Servidor Web &amp; Base de Datos Portátil"
                android:textColor="@color/game_emerald"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCloseServer"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_close"
            android:contentDescription="Cerrar" />
    </LinearLayout>

    <!-- Global Master Switch -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:background="@drawable/bg_game_badge">

        <TextView
            android:id="@+id/tvServerMasterStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Estado: Servicios Inactivos"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnToggleAllServices"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_aqua_button"
            android:text="Iniciar Todos"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingHorizontal="12dp" />
    </LinearLayout>

    <!-- Individual Services List -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="10dp">

        <!-- Apache HTTP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_aqua_pill">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Apache HTTP (v2.4) • Puerto 8080"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvStatusApache"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OFF"
                android:textColor="@color/dev_error_red"
                android:textStyle="bold"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- PHP Engine -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_aqua_pill">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PHP Engine (v8.3) • CLI/FPM"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvStatusPhp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OFF"
                android:textColor="@color/dev_error_red"
                android:textStyle="bold"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- MySQL Database -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_aqua_pill">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MySQL Database (v8.0) • Puerto 3306"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvStatusMysql"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OFF"
                android:textColor="@color/dev_error_red"
                android:textStyle="bold"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- PostgreSQL Database -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_aqua_pill">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PostgreSQL (v16.2) • Puerto 5432"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvStatusPostgres"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OFF"
                android:textColor="@color/dev_error_red"
                android:textStyle="bold"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Network Info & LAN Address -->
    <TextView
        android:id="@+id/tvLanAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="LAN IP: http://192.168.1.50:8080 (Listo para pruebas en red local)"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <!-- Open in MBrowser Button -->
    <Button
        android:id="@+id/btnOpenLocalhostInBrowser"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_aqua_button"
        android:text="Abrir http://localhost:8080 en MBrowser"
        android:textColor="@color/text_primary"
        android:textStyle="bold" />
</LinearLayout>

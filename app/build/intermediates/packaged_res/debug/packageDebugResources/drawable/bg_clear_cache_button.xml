<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4DFF5252">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <stroke
                        android:width="1.2dp"
                        android:color="#FF5252" />
                    <gradient
                        android:angle="270"
                        android:startColor="#B3D50000"
                        android:centerColor="#99B71C1C"
                        android:endColor="#807F0000" />
                </shape>
            </item>
            <item android:bottom="14dp">
                <shape android:shape="rectangle">
                    <corners
                        android:topLeftRadius="14dp"
                        android:topRightRadius="14dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#80FFFFFF"
                        android:endColor="#10FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>

<?xml version="1.0" encoding="utf-8"?>
<!-- Glass Bar with Aero Vista / Aqua translucent gradient and glowing border -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glow border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/aero_glass_border" />
            <solid android:color="@color/aero_glass_surface" />
        </shape>
    </item>
    <!-- Specular highlight reflection on upper half (Windows Vista / Aqua gloss effect) -->
    <item
        android:bottom="20dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="20dp"
                android:topRightRadius="20dp" />
            <gradient
                android:angle="270"
                android:startColor="#30FFFFFF"
                android:endColor="#05FFFFFF" />
        </shape>
    </item>
</layer-list>

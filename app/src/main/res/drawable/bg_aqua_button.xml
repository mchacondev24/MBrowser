<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4DFFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#8000E5FF" />
                    <gradient
                        android:angle="270"
                        android:startColor="#00A2FF"
                        android:centerColor="#0066CC"
                        android:endColor="#004499" />
                </shape>
            </item>
            <!-- Mac Aqua Top Half Gel / Glass Glare -->
            <item android:bottom="16dp">
                <shape android:shape="rectangle">
                    <corners
                        android:topLeftRadius="14dp"
                        android:topRightRadius="14dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#80FFFFFF"
                        android:endColor="#10FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>

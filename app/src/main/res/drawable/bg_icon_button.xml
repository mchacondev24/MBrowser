<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4D00E5FF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <stroke
                        android:width="1dp"
                        android:color="@color/aero_glass_border" />
                    <solid android:color="#2600E5FF" />
                </shape>
            </item>
            <item
                android:bottom="14dp"
                android:left="4dp"
                android:right="4dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#4DFFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>

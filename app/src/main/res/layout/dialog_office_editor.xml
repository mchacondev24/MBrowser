<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_glass_card">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivEditorDocType"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_description"
            android:tint="@color/aqua_cyan" />

        <TextView
            android:id="@+id/tvEditorTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Documento.docx"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="middle" />

        <ImageButton
            android:id="@+id/btnDriveSyncEditor"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_cloud"
            android:contentDescription="Sincronizar en Drive" />

        <ImageButton
            android:id="@+id/btnCloseEditor"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_close"
            android:contentDescription="Cerrar" />
    </LinearLayout>

    <!-- AI Toolbar Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:padding="6dp"
        android:background="@drawable/bg_dev_badge">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_auto_awesome"
            android:tint="@color/dev_purple" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Gemini AI Assistant"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAiSummarize"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_aqua_pill"
            android:text="Resumir"
            android:textColor="@color/text_primary"
            android:textSize="10sp"
            android:paddingHorizontal="6dp" />

        <Button
            android:id="@+id/btnAiImprove"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_aqua_pill"
            android:text="Mejorar"
            android:textColor="@color/text_primary"
            android:textSize="10sp"
            android:paddingHorizontal="6dp" />
    </LinearLayout>

    <!-- Document Content Editor / Viewer -->
    <EditText
        android:id="@+id/etDocumentContent"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="10dp"
        android:background="#26000000"
        android:gravity="top|start"
        android:padding="10dp"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:fontFamily="sans-serif"
        android:inputType="textMultiLine"
        android:scrollbars="vertical" />

    <!-- Action Buttons (Save, Print Preview, Export PDF) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btnSaveDocument"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_aqua_button"
            android:text="Guardar"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPrintPreview"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_glass_card"
            android:text="Vista Previa / PDF"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark_navy">

    <!-- Top Code Editor Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:background="@drawable/bg_glass_bar"
        android:elevation="6dp">

        <Button
            android:id="@+id/btnBackToFilesFromEditor"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_aqua_button"
            android:text="← Volver a htdocs"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="11sp"
            android:paddingHorizontal="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEditorFileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="index.php"
                android:textColor="@color/turbo_yellow"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Editor de Código Web (Apache / PHP)"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSaveCodeFile"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_game_badge"
            android:text="💾 Guardar"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="12sp"
            android:paddingHorizontal="12dp" />

        <ImageButton
            android:id="@+id/btnCloseCodeEditor"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_close"
            android:tint="@color/text_primary"
            android:contentDescription="Cerrar" />
    </LinearLayout>

    <!-- Quick Code Snippets Toolbar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="#1500E5FF"
        android:paddingVertical="4dp"
        android:paddingHorizontal="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSnippetPhp"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_aqua_pill"
                android:text="&lt;?php ?&gt;"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:paddingHorizontal="8dp" />

            <Button
                android:id="@+id/btnSnippetEcho"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_aqua_pill"
                android:text="echo &quot;...&quot;;"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:paddingHorizontal="8dp" />

            <Button
                android:id="@+id/btnSnippetHtml5"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_aqua_pill"
                android:text="HTML5 Boilerplate"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:paddingHorizontal="8dp" />

            <Button
                android:id="@+id/btnSnippetMysql"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_aqua_pill"
                android:text="MySQLi Connect"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:paddingHorizontal="8dp" />

            <Button
                android:id="@+id/btnSnippetJson"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_aqua_pill"
                android:text="JSON API Header"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:paddingHorizontal="8dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Code Editor Canvas -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="8dp"
        android:background="@drawable/bg_glass_card"
        android:padding="2dp">

        <EditText
            android:id="@+id/etCodeContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:gravity="top|start"
            android:padding="12dp"
            android:textColor="@color/turbo_yellow"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:inputType="textMultiLine|textNoSuggestions"
            android:scrollbars="vertical|horizontal"
            android:scrollHorizontally="true"
            android:hint="&lt;?php\n// Escribe tu código PHP / HTML aquí...\n"
            android:textColorHint="@color/text_muted" />
    </FrameLayout>

    <!-- Footer Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:background="@drawable/bg_glass_bar">

        <TextView
            android:id="@+id/tvCodeCharCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Líneas: 0 • Caracteres: 0"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Apache htdocs/ • UTF-8"
            android:textColor="@color/aqua_cyan"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>

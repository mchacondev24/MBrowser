<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="10dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_glass_card"
    android:clickable="true"
    android:focusable="true">

    <!-- File Extension / Folder Icon -->
    <TextView
        android:id="@+id/tvFileBadge"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:background="@drawable/bg_aqua_pill"
        android:text="PHP"
        android:textColor="@color/text_primary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- File Meta -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="index.php"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvFileMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3.2 KB • Modificado hoy"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- File Actions -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnOpenFileInBrowser"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_language"
            android:tint="@color/aqua_cyan"
            android:padding="6dp"
            android:contentDescription="Abrir en Navegador" />

        <ImageButton
            android:id="@+id/btnEditFileCode"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_code"
            android:tint="@color/turbo_yellow"
            android:padding="6dp"
            android:contentDescription="Editar Código" />

        <ImageButton
            android:id="@+id/btnFileMoreOptions"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_more_vert"
            android:tint="@color/text_secondary"
            android:padding="6dp"
            android:contentDescription="Más Opciones" />
    </LinearLayout>

</LinearLayout>
